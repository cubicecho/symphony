# The key MCP clients (Claude Code on another machine) send as `x-api-key`. Unset, /mcp refuses every call.
# Make one with: openssl rand -hex 32
SYMPHONY_MCP_KEY=

# Where the server listens. HOST defaults to 0.0.0.0 so other machines on the network can reach it.
# PORT=3000
# HOST=0.0.0.0

# Announce Symphony on the LAN over mDNS (_mcp._tcp), so tools like mcp-router find it. In Docker this needs
# network_mode: host (see docker-compose.yml). /.well-known/ai-catalog.json is served either way.
# LAN_ADVERTISE=false

# The built-in database (PGlite) lives in DATA_DIR/pg. Set DATABASE_URL=postgres://… to use Postgres instead.
# DATA_DIR=data
# DATABASE_URL=

# Upstream header values may reference variables named SYMPHONY_…, written as ${env:SYMPHONY_SHOP_TOKEN}.
# SYMPHONY_SHOP_TOKEN=

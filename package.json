{
  "name": "symphony",
  "private": true,
  "license": "MIT",
  "version": "1.1.0",
  "description": "Runtime web UIs over introspected GraphQL APIs: agents and people write React modules against a cached schema, Symphony checks and compiles them, and pages show them with live data.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "PORT=8787 node --env-file-if-exists=.env --watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run codegen && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.ts",
    "codegen": "node server/graphql/write-schema.ts && graphql-codegen && tsr generate",
    "check": "npm run check:biome && npm run check:types",
    "check:biome": "biome check --write .",
    "check:types": "npm run codegen && tsc --noEmit -p server && tsc --noEmit -p web",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "fixture:upstream": "node scripts/fixture-upstream.ts",
    "catalog:sync": "node scripts/sync-catalog.ts",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@babel/parser": "^8.1.3",
    "@babel/traverse": "^8.1.3",
    "@electric-sql/pglite": "^0.5.17",
    "@escape.tech/graphql-armor-max-aliases": "^2.6.2",
    "@escape.tech/graphql-armor-max-depth": "^2.4.2",
    "@graphql-hive/gateway-runtime": "2.14.4",
    "@graphql-mesh/fusion-composition": "0.11.4",
    "@graphql-mesh/transport-common": "1.1.3",
    "@graphql-mesh/transport-http": "1.2.7",
    "@graphql-mesh/transport-rest": "0.12.5",
    "@graphql-tools/utils": "^13.2.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@omnigraph/openapi": "0.112.7",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.5",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "graphql": "^16.15.0",
    "graphql-query-complexity": "^2.0.0",
    "graphql-yoga": "^5.24.6",
    "pg": "^8.23.1",
    "react-day-picker": "^10.0.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/types": "^8.1.3",
    "@biomejs/biome": "^2.6.9",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typed-document-node": "^8.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-codegen/typescript-operations": "^7.0.2",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.7",
    "drizzle-kit": "1.0.0-rc.5",
    "lucide-react": "^1.80.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
